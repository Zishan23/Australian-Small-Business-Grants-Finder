{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListRawBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::australian-small-business-grants-finder"
    },
    {
      "Sid": "ReadWriteRawBucketObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::australian-small-business-grants-finder/*"
    }
  ]
}
